# Copy to .env.local (development) or set these in your hosting panel (production).

# Hostnames that serve the store, dashboard and admin panel (comma separated).
# A leading "www." is ignored, so the bare domain covers www too.
# Leave empty in development. In production set it to your own domain, otherwise
# customer custom-domain routing cannot tell your site apart from theirs.
PLATFORM_HOSTS=

# Where uploaded media and the JSON database live. Point this outside the app
# directory in production so the data survives a redeploy, e.g. /var/lib/4xcms
DATA_DIR=

# Seeded on the first admin sign-in only. Change the password in the panel afterwards.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-deploying

# Razorpay webhook signing secret (see PRD 4.3)
RAZORPAY_WEBHOOK_SECRET=local-dev-webhook-secret
