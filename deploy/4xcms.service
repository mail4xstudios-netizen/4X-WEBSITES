[Unit]
Description=4XCMS Theme Store
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/4xcms
EnvironmentFile=/opt/4xcms/.env.production
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/4xcms/.next/standalone/server.js
Restart=always
RestartSec=3
User=www-data
StateDirectory=4xcms
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/4xcms

[Install]
WantedBy=multi-user.target
